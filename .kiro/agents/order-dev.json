{
  "name": "order-dev",
  "description": "ts-sample-order development agent. Same tools as kirocrew, plus a gate: verify before commit/push/PR, order-reviewer review before PR.",
  "model": "auto",
  "prompt": "file:///Applications/KiroCrew.app/Contents/Resources/backend-dist/kirocrew-backend-arm64/lib/python3.12/site-packages/kiro_crew/config/prompt.md",
  "tools": [
    "execute_bash",
    "fs_read",
    "fs_write",
    "code",
    "grep",
    "glob",
    "web_fetch",
    "web_search",
    "introspect",
    "session",
    "report",
    "tool_search",
    "@kirocrew-cron",
    "@kirocrew-core",
    "@kirocrew-computer"
  ],
  "allowedTools": [
    "web_fetch",
    "web_search",
    "introspect",
    "session",
    "report",
    "@kirocrew-cron/cron_list",
    "@kirocrew-cron/cron_pause",
    "@kirocrew-cron/cron_resume",
    "@kirocrew-cron/cron_trigger",
    "@kirocrew-cron/cron_remove",
    "@kirocrew-cron/cron_remove_all",
    "@kirocrew-core"
  ],
  "resources": [
    "file://AGENTS.md",
    "file://.kiro/steering/**/*.md"
  ],
  "includeMcpJson": false,
  "hooks": {
    "postToolUse": [
      {
        "matcher": "execute_bash",
        "command": "{ echo \"$(date -u +%Y-%m-%dT%H:%M:%SZ) BASH:\"; cat; echo; } >> \"${KIROCREW_HOME:-$HOME/.kiro/crew}/audit.log\""
      },
      {
        "matcher": "@kirocrew-core/spawn_sub_agents",
        "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/dev-gate.py\" post",
        "timeout_ms": 60000
      }
    ],
    "preToolUse": [
      {
        "matcher": "execute_bash",
        "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/dev-gate.py\" pre",
        "timeout_ms": 300000
      }
    ]
  },
  "mcpServers": {
    "kirocrew-cron": {
      "command": "/Applications/KiroCrew.app/Contents/Resources/backend-dist/kirocrew-backend-arm64/bin/kirocrew",
      "args": [
        "mcp-cron"
      ]
    },
    "kirocrew-core": {
      "command": "/Applications/KiroCrew.app/Contents/Resources/backend-dist/kirocrew-backend-arm64/bin/kirocrew",
      "args": [
        "mcp-core"
      ]
    },
    "kirocrew-computer": {
      "command": "/Applications/KiroCrew.app/Contents/Resources/backend-dist/kirocrew-backend-arm64/bin/kirocrew",
      "args": [
        "mcp-computer"
      ]
    }
  },
  "permissions": {
    "rules": [
      {
        "capability": "mcp",
        "match": [
          "kirocrew-core/*",
          "kirocrew-cron/cron_list",
          "kirocrew-cron/cron_pause",
          "kirocrew-cron/cron_remove",
          "kirocrew-cron/cron_remove_all",
          "kirocrew-cron/cron_resume",
          "kirocrew-cron/cron_trigger"
        ],
        "effect": "allow"
      },
      {
        "capability": "web_fetch",
        "effect": "allow"
      },
      {
        "capability": "web_search",
        "effect": "allow"
      }
    ]
  }
}
